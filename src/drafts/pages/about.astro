---
/**
 * ABOUT REWRITE TEMPLATE. Visible only in `npm run dev`, at /drafts/about
 * (the live page at /about is untouched until you publish this).
 *
 * To publish: replace every ✎, then move this file over src/pages/about.astro.
 * Imports use `@/`, so the move needs no edits. The build refuses any leftover ✎.
 *
 * Why a rewrite: the live page is the 2019 student voice — an unsourced "90% of
 * humanity" statistic, two goals that read "still being written", and no mention
 * of what you do now. The career journey below is real and shared with /about.
 */
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import DevHint from '@/components/DevHint.astro';
import { JOURNEY as journey } from '@/data/journey';
---

<Base
  title="About | Mostafa Okasha"
  description="✎ One line for search results and link previews: who you are and what you build now."
  draft
  source="src/drafts/pages/about.astro"
>
  <Nav current="about" />

  <div class="wrap">
    <h1 class="page-title">✎ A one-line headline about who you are now</h1>
    <p class="page-sub">✎ A sub-line — e.g. what you build, where, and for whom.</p>

    <div class="bio">
      <img class="me" src="/images/webp/profile-pic.webp" alt="Mostafa Okasha" />
      <div class="bio-text">
        <p>
          ✎ <b>Now.</b> Who you are in 2026 in two or three sentences: what you are building (your
          startup / current AI work), and what kind of problems you are best at.
        </p>
        <p>
          ✎ <b>How you got here.</b> The short version of the path — Mechatronics → Capital One →
          Scale AI → Meta → building your own things. One sentence per turn, and the thread that
          connects them.
        </p>
        <p>
          ✎ <b>What you care about.</b> Specific beats inspirational: a problem you keep coming back
          to, and why.
        </p>
      </div>
    </div>
    <DevHint title="Photo" file="images/webp/profile-pic.webp">
      <p>The rest of the site reads as 2026; if this photo doesn't, drop a newer one next to it and change the <code>src</code> above.</p>
    </DevHint>

    <div class="section-label sec">01 · NOW</div>
    <ul class="values">
      <li>✎ <b>Building</b> — what you're working on, with a link to its case study once it exists.</li>
      <li>✎ <b>Learning</b> — e.g. the program you're starting, or the area you're going deep on.</li>
      <li>✎ <b>Open to</b> — what you'd like people to contact you about (consulting, roles, collaborations).</li>
    </ul>

    <div class="section-label sec">02 · WHAT I BELIEVE</div>
    <ul class="values">
      <li>✎ A principle you actually work by, plus the moment that taught it to you.</li>
      <li>✎ A second one. Concrete beats generic — "always give 100%" says nothing a reader can use.</li>
      <li>✎ A third — or stop at two. Two real ones beat three filler ones.</li>
    </ul>

    <div class="section-label sec">03 · WHAT I'M WORKING TOWARD</div>
    <div class="goals">
      <p>
        ✎ One or two goals, stated specifically. If you keep the healthcare goal, keep the conviction
        and drop the unsourced "90%" figure — or cite a source for any statistic you use.
      </p>
    </div>

    <div class="section-label sec">04 · INTERESTS</div>
    <div class="chips">
      {
        ['Piano', 'Ukulele', 'Photography', 'Archery', 'Painting', 'Swimming', 'Soccer', 'Designing', 'Ridiculously good Google Reviews', 'Anime'].map(
          (i) => <span class="chip-slate">{i}</span>
        )
      }
    </div>
    <DevHint title="Interests" file="src/drafts/pages/about.astro">
      <p>These are your current chips, kept as-is. Trim or add; they are fine as they are.</p>
    </DevHint>

    <div class="section-label sec">05 · THE WHOLE JOURNEY</div>
    <DevHint title="Confirm your Meta end date" file="src/data/journey.ts (line 20)">
      <p>The site says <b>Nov 2024 — Feb 2026</b>; an earlier note said <b>January 2026</b>. It is a public
      claim, so change it everywhere it appears: <code>src/data/journey.ts:20</code>,
      <code>src/pages/resume.astro:41</code>, and the downloadable <code>resume/resume.pdf</code>.</p>
    </DevHint>
    <div class="journey">
      {
        journey.map((j) => (
          <div class="stop">
            <div class="stop-head">
              {j.logo ? (
                <img src={j.logo} alt={`${j.org} logo`} loading="lazy" />
              ) : (
                <span class="lettermark mono" style={`color:${j.color}; border-color:${j.color};`}>{j.badge}</span>
              )}
              <div>
                <div class="stop-role">{j.role} <span class="at">@ {j.org}</span></div>
                <div class="stop-when mono">{j.when}</div>
              </div>
            </div>
            <ul>
              {j.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="epilogue">
      <blockquote>
        ✎ Keep the Tolstoy line ("Everyone thinks of changing the world, but no one thinks of changing
        himself.") or choose one that fits who you are now.
        <span class="who">— ✎ attribution</span>
      </blockquote>
      <div class="sign mono">
        Never stop improving.
        <img src="/images/my-signature.png" alt="Signature" />
      </div>
    </div>
  </div>
</Base>

<style>
  .wrap { padding: 40px 44px 70px; max-width: 880px; margin: 0 auto; }
  .sec { margin-top: 48px; }

  .bio { margin-top: 30px; display: flex; gap: 32px; align-items: flex-start; }
  .me {
    width: 190px;
    flex: none;
    border-radius: 14px;
    border: 1px solid var(--mint-border);
  }
  .bio-text p { font-size: 16px; line-height: 1.7; color: var(--text-body); margin: 0 0 16px; }
  .bio-text b { color: var(--text-bright); font-weight: 600; }

  .values { margin: 16px 0 0; padding-left: 0; list-style: none; }
  .values li {
    padding: 12px 0 12px 26px;
    border-bottom: 1px solid var(--mint-divider);
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    position: relative;
  }
  .values li::before { content: '▹'; position: absolute; left: 2px; color: var(--mint); }
  .values li.tbd { font-size: 12.5px; color: var(--text-muted); }
  .values li.tbd a { color: var(--mint); }

  .goals p { margin: 16px 0 0; font-size: 16px; line-height: 1.7; color: var(--text-body); }
  .goals b { color: var(--text-bright); }

  .chips { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--font-mono); font-size: 12px; }

  .journey { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .stop { border-bottom: 1px solid var(--mint-divider); padding: 20px 0; }
  .stop-head { display: flex; gap: 16px; align-items: center; }
  .stop-head img { width: 52px; height: 52px; object-fit: contain; flex: none; }
  .lettermark {
    width: 52px; height: 52px; flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid; border-radius: 12px;
    font-size: 20px; font-weight: 600;
  }
  .stop-role { font-size: 17px; font-weight: 600; color: rgb(204, 214, 246); }
  .stop-role .at { color: var(--mint); }
  .stop-when { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .stop ul { margin: 12px 0 0; padding-left: 20px; }
  .stop li { font-size: 14.5px; line-height: 1.65; color: var(--text-body); margin: 6px 0; }

  .epilogue { margin-top: 56px; text-align: center; }
  .epilogue blockquote {
    margin: 0 auto;
    max-width: 560px;
    font-size: 19px;
    font-style: italic;
    color: var(--text-bright);
    line-height: 1.6;
  }
  .epilogue .who { display: block; margin-top: 10px; font-size: 14px; font-style: normal; color: var(--text-muted); }
  .sign { margin-top: 30px; font-size: 12px; color: var(--text-muted); letter-spacing: 0.1em; }
  .sign img { display: block; margin: 14px auto 0; width: 130px; filter: invert(1) brightness(1.4); opacity: 0.85; }

  @media (max-width: 768px) {
    .wrap { padding: 28px 20px 56px; }
    .bio { flex-direction: column; }
    .me { width: 55%; margin: 0 auto; }
  }
</style>
