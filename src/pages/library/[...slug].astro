---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getCollection, render } from 'astro:content';
import { SHELF_TYPES, fmtMeta } from '../../data/shelves';

export async function getStaticPaths() {
  const entries = await getCollection('library', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const shelf = SHELF_TYPES[entry.data.type];
const dateStr = entry.data.date
  .toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
  .toUpperCase();
const rt = entry.data.readingTime;
---

<Base title={`${entry.data.title} | Mostafa Okasha`} description={entry.data.description}>
  <div class="reading-progress" data-progress></div>
  <Nav current="library" />

  <article class="article">
    <div class="top-row mono">
      <a href={`/library?shelf=${entry.data.type}`}>← {shelf.label}</a>
      {rt && <span data-time-left>{rt} min left</span>}
    </div>

    <div class="kicker mono" style={`color:${shelf.color};`}>
      {shelf.badge} · {dateStr}{rt && ` · ${rt} MIN`}
    </div>
    <h1 class="title">{entry.data.title}</h1>

    {
      entry.data.book && (
        <div class="book-meta">
          {entry.data.book.cover && (
            <img class="book-cover" src={entry.data.book.cover} alt={`${entry.data.title} cover`} />
          )}
          <dl class="book-props">
            <div class="prop">
              <dt>Author</dt>
              <dd>{entry.data.book.author}</dd>
            </div>
            {entry.data.book.categories.length > 0 && (
              <div class="prop">
                <dt>Category</dt>
                <dd class="cats">
                  {entry.data.book.categories.map((c) => (
                    <span class="cat">{c}</span>
                  ))}
                </dd>
              </div>
            )}
            {entry.data.book.pages && (
              <div class="prop">
                <dt># of Pages</dt>
                <dd>{entry.data.book.pages}</dd>
              </div>
            )}
            {entry.data.book.published && (
              <div class="prop">
                <dt>Published</dt>
                <dd>{entry.data.book.published}</dd>
              </div>
            )}
            {entry.data.book.publisher && (
              <div class="prop">
                <dt>Publisher</dt>
                <dd>{entry.data.book.publisher}</dd>
              </div>
            )}
            {entry.data.book.rating != null && (
              <div class="prop">
                <dt>Rating</dt>
                <dd class="rating">
                  {'★'.repeat(Math.round(entry.data.book.rating))}
                  <span class="rating-empty">{'★'.repeat(5 - Math.round(entry.data.book.rating))}</span>
                </dd>
              </div>
            )}
            {entry.data.book.status && (
              <div class="prop">
                <dt>Status</dt>
                <dd>
                  <span class={`status status-${entry.data.book.status.replace(/\s+/g, '-').toLowerCase()}`}>
                    {entry.data.book.status}
                  </span>
                </dd>
              </div>
            )}
            {(entry.data.book.links?.goodreads || entry.data.book.links?.amazon) && (
              <div class="prop">
                <dt>Links</dt>
                <dd class="links">
                  {entry.data.book.links?.goodreads && (
                    <a href={entry.data.book.links.goodreads} target="_blank" rel="noopener">
                      Goodreads
                    </a>
                  )}
                  {entry.data.book.links?.amazon && (
                    <a href={entry.data.book.links.amazon} target="_blank" rel="noopener">
                      Amazon
                    </a>
                  )}
                </dd>
              </div>
            )}
          </dl>
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <div class="foot">
      <a href="/library" class="chip-mint">← back to the library</a>
      {
        entry.data.topics.length > 0 && (
          <span class="topics mono">
            {entry.data.topics.map((t) => (
              <span class="topic">#{t}</span>
            ))}
          </span>
        )
      }
    </div>
  </article>
</Base>

<script>
  // reading progress bar + "N min left"
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const timeLeft = document.querySelector<HTMLElement>('[data-time-left]');
  const totalMin = timeLeft ? parseInt(timeLeft.textContent || '0', 10) : 0;
  const update = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, window.scrollY / max) : 1;
    bar.style.width = `${p * 100}%`;
    if (timeLeft && totalMin) {
      const left = Math.max(0, Math.ceil(totalMin * (1 - p)));
      timeLeft.textContent = left > 0 ? `${left} min left` : 'done ✓';
    }
  };
  window.addEventListener('scroll', update, { passive: true });
  update();

  // one-click copy on code blocks
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'copy';
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
      btn.textContent = 'copied ✓';
      setTimeout(() => (btn.textContent = 'copy'), 1500);
    });
    pre.appendChild(btn);
  });
</script>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 20px 80px;
  }
  .top-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
  }
  .top-row a { color: var(--text-muted); }
  .top-row a:hover { color: var(--mint); }
  .kicker {
    margin-top: 30px;
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .title {
    margin: 14px 0 26px;
    font-weight: 700;
    font-size: 44px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }

  /* book properties panel (Notion-style) */
  .book-meta {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin: 0 0 34px;
    padding: 22px 24px;
    border: 1px solid var(--mint-border-soft);
    border-radius: 14px;
    background: var(--navy-raised);
  }
  .book-cover {
    width: 120px;
    flex: none;
    border-radius: 6px;
    border: 1px solid var(--mint-border-soft);
  }
  .book-props { margin: 0; flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .book-props .prop {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 14px;
    align-items: baseline;
  }
  .book-props dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .book-props dd { margin: 0; font-size: 14.5px; color: var(--text-body); }
  .book-props .cats { display: flex; flex-wrap: wrap; gap: 6px; }
  .book-props .cat {
    font-size: 12px;
    color: var(--text-bright);
    background: rgba(100, 255, 218, 0.08);
    border: 1px solid var(--mint-border);
    border-radius: 5px;
    padding: 2px 9px;
  }
  .book-props .rating { color: var(--c-paper); letter-spacing: 2px; }
  .book-props .rating-empty { color: var(--slate-border); }
  .book-props .status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: 999px;
    padding: 3px 12px;
  }
  .status-to-read { background: rgba(137, 146, 176, 0.15); color: var(--text-muted); border: 1px solid var(--slate-border); }
  .status-in-progress { background: rgba(124, 183, 255, 0.14); color: var(--c-cs); border: 1px solid rgba(124, 183, 255, 0.4); }
  .status-finished { background: rgba(125, 234, 216, 0.14); color: var(--c-book); border: 1px solid rgba(125, 234, 216, 0.4); }
  .book-props .links { display: flex; gap: 12px; }
  .book-props .links a { color: var(--mint); border-bottom: 1px dashed rgba(100, 255, 218, 0.4); }

  @media (max-width: 640px) {
    .book-meta { flex-direction: column; gap: 16px; }
    .book-cover { width: 96px; }
    .book-props .prop { grid-template-columns: 1fr; gap: 2px; }
  }

  .foot {
    margin-top: 50px;
    padding-top: 22px;
    border-top: 1px solid var(--mint-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .topics { display: flex; gap: 12px; font-size: 12px; color: var(--text-muted); }

  @media (max-width: 768px) {
    .title { font-size: 30px; }
  }
</style>
