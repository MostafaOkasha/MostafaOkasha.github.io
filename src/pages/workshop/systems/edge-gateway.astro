        <text x="278" y="49" fill="#8892b0" font-size="8">watch stream (ADDED/MODIFIED/DELETED)</text>
        <rect x="90" y="54" width="220" height="128" rx="8" fill="none" stroke="#64ffda" stroke-width="1.2" stroke-dasharray="4 3"></rect>
        <text x="200" y="70" fill="#64ffda" font-size="9" text-anchor="middle">Python watcher · control plane</text>
        <rect x="118" y="80" width="164" height="22" rx="4" fill="none" stroke="#7cb7ff" stroke-width="1"></rect>
        <text x="200" y="95" fill="#7cb7ff" font-size="8.5" text-anchor="middle">in-memory ingress cache</text>
        <rect x="118" y="108" width="164" height="22" rx="4" fill="none" stroke="#7cb7ff" stroke-width="1"></rect>
        <text x="200" y="123" fill="#7cb7ff" font-size="8.5" text-anchor="middle">Jinja2 render → hash → diff</text>
        <rect x="118" y="136" width="164" height="22" rx="4" fill="none" stroke="#7cb7ff" stroke-width="1"></rect>
        <text x="200" y="151" fill="#7cb7ff" font-size="8.5" text-anchor="middle">atomic write (tmp → rename)</text>
        <text x="200" y="174" fill="#8892b0" font-size="8" text-anchor="middle">+ debounce batching · periodic full resync</text>
        <line x1="200" y1="182" x2="200" y2="200" stroke="#495670" stroke-width="1"></line>
        <text x="255" y="195" fill="#8892b0" font-size="8">nginx -s reload</text>
        <rect x="120" y="200" width="160" height="28" rx="6" fill="none" stroke="#ffd76b" stroke-width="1.3"></rect>
        <text x="200" y="218" fill="#ffd76b" font-size="10" text-anchor="middle">NGINX · data plane</text>
