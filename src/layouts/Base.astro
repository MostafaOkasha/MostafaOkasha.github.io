---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  /** og:image path */
  image?: string;
}
const {
  title,
  description = 'Mostafa Okasha — engineer. Writing, projects, CAD, system designs, and an interactive resume.',
  image = '/images/webp/DSC_0027.webp',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a192f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mostafa Okasha" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/icon/icon.ico/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icon/icon.ico/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/icon.ico/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Mostafa Okasha — The Library" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CommandPalette />
    <Lightbox />
  </body>
</html>
