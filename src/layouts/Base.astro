---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  /** og:image path */
  image?: string;
  /** 'article' for library entries, book pages, and case studies */
  type?: 'website' | 'article';
  /** ISO date — emitted as article:published_time + JSON-LD datePublished */
  published?: Date;
  /** dev only: stamp this page as a template (never true in a production build) */
  draft?: boolean;
  /** dev only: the file to edit, shown on the draft banner */
  source?: string;
}
const {
  title,
  description = 'Mostafa Okasha — engineer. Writing, projects, CAD, system designs, and an interactive resume.',
  image = '/images/webp/DSC_0027.webp',
  type = 'website',
  published,
  draft = false,
  source,
} = Astro.props;
const DEV = import.meta.env.DEV;
// Dev-only template styling + ✎ highlighter. Injected only when DEV, so production
// output (and the shared CSS bundle) stays byte-identical. See src/data/drafts.ts.
const DEV_CSS = `
            .dev-draft-banner { position: sticky; top: 0; z-index: 60; padding: 9px 16px;
              background: #3a2f0b; color: #ffe8a3; border-bottom: 1px solid #ffd76b;
              font: 12.5px/1.5 var(--font-mono); }
            .dev-draft-banner b { color: #ffd76b; letter-spacing: .08em; }
            .dev-draft-banner code { color: #fff3c7; }
            .dev-draft-banner a { color: #ffd76b; text-decoration: underline; }
            mark.ph { background: rgba(255, 215, 107, .16); color: #ffe8a3; border-radius: 3px;
              padding: 0 3px; box-shadow: inset 0 -1px 0 rgba(255, 215, 107, .6); }
            .dev-chip { display: inline-block; margin-left: 8px; padding: 1px 7px; border-radius: 4px;
              border: 1px solid #ffd76b; color: #ffd76b; font: 600 10px/1.5 var(--font-mono);
              letter-spacing: .08em; vertical-align: middle; }
            .dev-hint { margin: 18px 0; padding: 16px 18px; border: 1.5px dashed rgba(255, 215, 107, .55);
              border-radius: 12px; background: rgba(255, 215, 107, .05); color: var(--text-body);
              font-size: 14px; line-height: 1.6; }
            .dev-hint-title { font: 600 11px/1.4 var(--font-mono); letter-spacing: .1em; color: #ffd76b;
              text-transform: uppercase; margin-bottom: 8px; }
            .dev-hint code { color: #ffe8a3; font-size: 12.5px; }
            .dev-hint :is(h2, h3) { margin: 18px 0 6px; color: var(--text-bright); font-size: 17px; }
            .dev-hint p, .dev-hint ul { margin: 6px 0; }
            .dev-ph-cover { display: flex; align-items: center; justify-content: center; text-align: center;
              padding: 16px; min-height: 190px; border-bottom: 1px dashed rgba(255, 215, 107, .5);
              color: #ffd76b; font: 12px/1.6 var(--font-mono); background: rgba(255, 215, 107, .04); }
            .dev-slot { min-height: 220px; display: flex; align-items: center; justify-content: center;
              text-align: center; padding: 16px; border: 1.5px dashed rgba(255, 215, 107, .55);
              border-radius: 14px; color: #ffd76b; font: 12px/1.7 var(--font-mono); }
          `;
const DEV_JS = `
            (() => {
              // wrap every text run that contains the ✎ placeholder marker in <mark class="ph">
              const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                acceptNode: (n) => n.nodeValue.includes('\u270e') && !n.parentElement.closest('mark.ph, script, style, code')
                  ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
              });
              const hits = []; while (walker.nextNode()) hits.push(walker.currentNode);
              for (const n of hits) { const m = document.createElement('mark'); m.className = 'ph';
                n.parentNode.replaceChild(m, n); m.appendChild(n); }
            })();
          `;
// `build.format: 'file'` makes Astro.url.pathname end in `.html` at build time,
// but the served URL is extension-less (`trailingSlash: 'never'`). Normalise so
// the canonical matches the sitemap and the site's own internal links.
const canonicalPath =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(image, Astro.site);
const isArticle = type === 'article';

// JSON-LD: Person on the homepage, Article on written entries.
const schema = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImage.href,
      url: canonical.href,
      ...(published ? { datePublished: published.toISOString() } : {}),
      author: { '@type': 'Person', name: 'Mostafa Okasha', url: 'https://www.okasha.me' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Mostafa Okasha',
      url: 'https://www.okasha.me',
      image: ogImage.href,
      jobTitle: 'Software Engineer',
      email: 'mailto:mostafa@okasha.me',
      sameAs: [
        'https://github.com/MostafaOkasha',
        'https://www.linkedin.com/in/okashm',
      ],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a192f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mostafa Okasha" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="okasha.me" />
    {isArticle && published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    {isArticle && <meta property="article:author" content="Mostafa Okasha" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/icon/icon.ico/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icon/icon.ico/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/icon.ico/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Mostafa Okasha — The Library" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    {
      DEV && draft && (
        <div class="dev-draft-banner" role="note">
          <b>DRAFT</b> · template, only visible in <code>npm run dev</code>
          {source && <> · edit <code>{source}</code></>} · replace every highlighted <mark class="ph">✎</mark>, then
          remove <code>draft: true</code> · <a href="/drafts">all templates →</a>
        </div>
      )
    }
    <slot />
    <CommandPalette />
    <Lightbox />
    {
      /* Dev-only styling + placeholder highlighter. Kept inline and inside this
         DEV guard on purpose: production output must stay byte-identical, so no
         template styling may enter the shared CSS bundle. */
      DEV && (
        <>
          <style is:inline set:html={DEV_CSS} />
          <script is:inline set:html={DEV_JS} />
        </>
      )
    }
  </body>
</html>
