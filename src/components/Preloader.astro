---
/**
 * Cinematic intro: a spinning spiral galaxy that warps into its core to
 * reveal the homepage. Loading indicator + minimum 2s hold (even if the
 * page is ready sooner). Shows once per browser session; honours
 * prefers-reduced-motion. Self-contained canvas, no dependencies.
 */
---

<div class="preloader" data-preloader aria-hidden="true">
  <canvas data-galaxy></canvas>
  <div class="intro-ui">
    <div class="intro-label mono">entering the archive</div>
    <div class="bar"><div class="bar-fill" data-bar></div></div>
    <div class="intro-pct mono" data-pct>0%</div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #04040d;
    overflow: hidden;
    transform-origin: 50% 46%;
    will-change: transform, opacity;
  }
  .preloader canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .preloader.warp {
    animation: warp 1200ms cubic-bezier(0.7, 0, 0.84, 0) forwards;
  }
  @keyframes warp {
    to { transform: scale(9); opacity: 0; }
  }
  .preloader.gone { display: none; }

  .intro-ui {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: opacity 400ms ease;
  }
  .preloader.warp .intro-ui { opacity: 0; }
  .intro-label {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #b8a6ff;
    opacity: 0.85;
  }
  .bar {
    width: 220px;
    max-width: 60vw;
    height: 1px;
    background: rgba(184, 166, 255, 0.18);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #6b42eb, #48d9d9);
    box-shadow: 0 0 10px rgba(100, 217, 255, 0.7);
  }
  .intro-pct {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #7a86b8;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader.warp { animation: fadeout 500ms ease forwards; }
    @keyframes fadeout { to { opacity: 0; } }
  }
</style>

<script is:inline>
  (function () {
    var el = document.querySelector('[data-preloader]');
    if (!el) return;

    // once per session — skip instantly on later navigations (no flash)
    if (sessionStorage.getItem('okIntroSeen')) {
      el.parentNode && el.parentNode.removeChild(el);
      return;
    }
    sessionStorage.setItem('okIntroSeen', '1');

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.style.overflow = 'hidden';

    var canvas = el.querySelector('[data-galaxy]');
    var ctx = canvas.getContext('2d');
    var DPR = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0, cx = 0, cy = 0, maxR = 0;

    function resize() {
      var iw = window.innerWidth || document.documentElement.clientWidth || 0;
      var ih = window.innerHeight || document.documentElement.clientHeight || 0;
      var w = Math.floor(iw * DPR), h = Math.floor(ih * DPR);
      if (w === W && h === H) return;           // no change → keep the motion trails
      W = canvas.width = w; H = canvas.height = h;
      cx = W * 0.5; cy = H * 0.46; maxR = Math.min(W, H) * 0.62;
    }
    resize();
    window.addEventListener('resize', resize);

    // ---- build spiral galaxy ----
    // Two broad arms wound ~2.5 turns so, seen at a tilt, they read as fine
    // nested spiral rings (like the reference "record grooves").
    var ARMS = 2, TURNS = 2.55, TILT = 0.42;
    var VW = window.innerWidth || document.documentElement.clientWidth || 1440;
    var VH = window.innerHeight || document.documentElement.clientHeight || 900;
    var N = reduce ? 900 : Math.max(1800, Math.min(4200, Math.floor((VW * VH) / 420)));
    var parts = new Array(N);
    for (var i = 0; i < N; i++) {
      var u = Math.random();
      var rn = 0.08 + 0.92 * Math.pow(u, 0.85);      // radius fraction along the arm
      var arm = i % ARMS;
      var wind = u * TURNS * Math.PI * 2;            // angle winds as we go outward
      var jitter = (Math.random() - 0.5) * (0.22 + 0.14 * rn); // dust thickness on the arm
      var star = Math.random() < 0.07;               // ~7% brighter foreground stars
      parts[i] = {
        rn: rn + (Math.random() - 0.5) * 0.015,
        a0: arm * Math.PI + wind + jitter,
        size: (star ? 1.4 + Math.random() * 1.5 : 0.7 + Math.random() * 1.15) * DPR,
        tw: Math.random() * Math.PI * 2,
        tws: 1.2 + Math.random() * 2.4,
        br: (star ? 0.9 + Math.random() * 0.1 : 0.5 + Math.random() * 0.42)
      };
    }

    // blue-forward palette: white-blue core → violet → azure → cyan rim
    function colorFor(rn, k) {
      var r, g, b;
      if (rn < 0.14) { r = 224; g = 232; b = 255; }
      else if (rn < 0.34) { var t = (rn - 0.14) / 0.20; r = 224 + (150 - 224) * t; g = 232 + (135 - 232) * t; b = 255; }
      else if (rn < 0.64) { var t2 = (rn - 0.34) / 0.30; r = 150 + (74 - 150) * t2; g = 135 + (140 - 135) * t2; b = 255; }
      else { var t3 = (rn - 0.64) / 0.36; r = 74 + (96 - 74) * t3; g = 140 + (210 - 140) * t3; b = 255 + (255 - 255) * t3; }
      return 'rgba(' + (r | 0) + ',' + (g | 0) + ',' + (b | 0) + ',' + k.toFixed(3) + ')';
    }

    function drawCore() {
      // 1. compact soft halo
      var halo = ctx.createRadialGradient(cx, cy, 0, cx, cy, maxR * 0.30);
      halo.addColorStop(0, 'rgba(110,140,255,0.26)');
      halo.addColorStop(0.5, 'rgba(70,90,200,0.07)');
      halo.addColorStop(1, 'rgba(40,50,140,0)');
      ctx.fillStyle = halo;
      ctx.beginPath(); ctx.arc(cx, cy, maxR * 0.30, 0, Math.PI * 2); ctx.fill();
      // 2. mid glow
      var mid = ctx.createRadialGradient(cx, cy, 0, cx, cy, maxR * 0.085);
      mid.addColorStop(0, 'rgba(240,244,255,0.92)');
      mid.addColorStop(0.6, 'rgba(150,180,255,0.4)');
      mid.addColorStop(1, 'rgba(120,140,255,0)');
      ctx.fillStyle = mid;
      ctx.beginPath(); ctx.arc(cx, cy, maxR * 0.085, 0, Math.PI * 2); ctx.fill();
      // 3. hot point
      var hot = ctx.createRadialGradient(cx, cy, 0, cx, cy, maxR * 0.026);
      hot.addColorStop(0, 'rgba(255,255,255,1)');
      hot.addColorStop(1, 'rgba(220,235,255,0)');
      ctx.fillStyle = hot;
      ctx.beginPath(); ctx.arc(cx, cy, maxR * 0.026, 0, Math.PI * 2); ctx.fill();
      // 4. delicate anamorphic flare — thin, soft, subtle (NOT a bar)
      flare(maxR * 0.72, 2.4 * DPR, 'rgba(200,220,255,0.13)', false); // vertical
      flare(maxR * 0.40, 1.8 * DPR, 'rgba(210,225,255,0.08)', true);  // faint horizontal
    }
    function flare(len, halfw, col, horiz) {
      var g = horiz
        ? ctx.createLinearGradient(cx - len, cy, cx + len, cy)
        : ctx.createLinearGradient(cx, cy - len, cx, cy + len);
      g.addColorStop(0, 'rgba(255,255,255,0)');
      g.addColorStop(0.5, col);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.save();
      ctx.filter = 'blur(' + (2.5 * DPR) + 'px)';
      ctx.fillStyle = g;
      if (horiz) ctx.fillRect(cx - len, cy - halfw, len * 2, halfw * 2);
      else ctx.fillRect(cx - halfw, cy - len, halfw * 2, len * 2);
      ctx.restore();
    }

    var t0 = performance.now();
    var speedMul = 1;
    var raf = 0;

    function frame(now) {
      resize();                                 // self-corrects if mounted before layout
      if (!W || !H) { raf = requestAnimationFrame(frame); return; }
      var t = (now - t0) / 1000;
      var rot = t * 0.16 * speedMul;

      // light trail leaves a subtle streak while keeping the rings defined
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = 'rgba(4,4,13,0.28)';
      ctx.fillRect(0, 0, W, H);

      ctx.globalCompositeOperation = 'lighter';
      drawCore();

      for (var i = 0; i < N; i++) {
        var p = parts[i];
        var r = p.rn * maxR;
        // differential rotation — inner particles sweep faster
        var a = p.a0 + rot * (0.6 + 0.9 / (p.rn + 0.18));
        var x = cx + Math.cos(a) * r;
        var y = cy + Math.sin(a) * r * TILT;
        var tw = 0.65 + 0.35 * Math.sin(p.tw + t * p.tws);
        var k = p.br * tw * (1 - p.rn * 0.18);
        ctx.fillStyle = colorFor(p.rn, k);
        ctx.beginPath();
        ctx.arc(x, y, p.size, 0, Math.PI * 2);
        ctx.fill();
      }

      if (reduce) return;               // one static-ish frame is enough; loop still runs below
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);
    if (reduce) { raf = requestAnimationFrame(function loop(n){ frame(n); raf = requestAnimationFrame(loop); }); }

    // ---- loading bar + timing ----
    var barEl = el.querySelector('[data-bar]');
    var pctEl = el.querySelector('[data-pct]');
    var MIN = 2000;                     // minimum on-screen time
    var ready = false;
    window.addEventListener('load', function () { ready = true; });
    // safety: never hang if 'load' somehow doesn't fire
    setTimeout(function () { ready = true; }, 8000);

    function tick() {
      var elapsed = performance.now() - t0;
      // bar climbs to 90% over MIN, then completes once ready
      var timed = Math.min(elapsed / MIN, 1);
      var pct = ready ? Math.max(timed, 0.9) : timed * 0.9;
      if (ready && elapsed >= MIN) pct = 1;
      barEl.style.width = (pct * 100).toFixed(0) + '%';
      pctEl.textContent = (pct * 100).toFixed(0) + '%';
      if (pct >= 1 && ready && elapsed >= MIN) { finish(); return; }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    var finished = false;
    function finish() {
      if (finished) return; finished = true;
      speedMul = 6;                     // warp: spin up as we zoom in
      el.classList.add('warp');
      var done = function () {
        cancelAnimationFrame(raf);
        el.classList.add('gone');
        document.documentElement.style.overflow = '';
        window.removeEventListener('resize', resize);
        el.parentNode && el.parentNode.removeChild(el);
      };
      el.addEventListener('animationend', done, { once: true });
      setTimeout(done, 1400);           // fallback if animationend misses
    }
  })();
</script>
