---
// The search index is served from /search.json (src/data/search-index.ts),
// not inlined here — see that module for why.
---

<div class="palette-overlay" data-palette>
  <div class="palette" role="dialog" aria-modal="true" aria-labelledby="palette-label">
    <h2 id="palette-label" class="sr-only">Search the archive</h2>
    <div class="input-row">
      <span class="glyph" aria-hidden="true">⌕</span>
      <label for="palette-input" class="sr-only">Search the archive</label>
      <input
        id="palette-input"
        type="text"
        placeholder="search the archive…"
        data-palette-input
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="palette-results"
        aria-autocomplete="list"
      />
      <kbd>esc</kbd>
    </div>
    <div class="results" id="palette-results" role="listbox" aria-label="Results" data-palette-results></div>
    <div class="sr-only" aria-live="polite" data-palette-status></div>
    <div class="hint-row" aria-hidden="true">
      <span>↑↓ navigate</span>
      <span>↵ open</span>
      <span>esc close</span>
    </div>
  </div>
</div>

<script>
  type Item = { title: string; badge: string; color: string; meta: string; url: string; haystack: string };

  (() => {
    const overlay = document.querySelector<HTMLElement>('[data-palette]');
    if (!overlay) return;
    const input = overlay.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const resultsEl = overlay.querySelector<HTMLElement>('[data-palette-results]')!;
    const statusEl = overlay.querySelector<HTMLElement>('[data-palette-status]');
    let sel = 0;
    let shown: Item[] = [];

    // fetched once, on first open, then cached for the session (and by the browser)
    let items: Item[] | null = null;
    let loading: Promise<void> | null = null;
    const load = () =>
      (loading ??= fetch('/search.json')
        .then((r) => (r.ok ? r.json() : []))
        .then((data: Item[]) => {
          items = data;
        })
        .catch(() => {
          items = [];
        }));

    // results are user-visible strings interpolated into HTML — escape them
    const esc = (s: unknown) =>
      String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      );

    const render = () => {
      if (!items) {
        resultsEl.innerHTML = '<div class="empty">loading…</div>';
        return;
      }
      const q = input.value.trim().toLowerCase();
      shown = q ? items.filter((i) => i.haystack.includes(q) || i.title.toLowerCase().includes(q)) : items.slice(0, 8);
      sel = Math.min(sel, Math.max(0, shown.length - 1));
      resultsEl.innerHTML = shown.length
        ? shown
            .map(
              (i, idx) => `
        <a class="result ${idx === sel ? 'sel' : ''}" id="palette-opt-${idx}" role="option"
           aria-selected="${idx === sel}" href="${esc(i.url)}" data-url="${esc(i.url)}">
          <span class="badge" style="color:${esc(i.color)}; border:1px solid ${esc(i.color)}66;">${esc(i.badge)}</span>
          <span class="r-title">${esc(i.title)}</span>
          <span class="r-meta">${esc(i.meta)}</span>
        </a>`
            )
            .join('')
        : `<div class="empty">nothing in the archive matches "${esc(input.value)}"</div>`;
      resultsEl.querySelectorAll('.result').forEach((el, idx) => {
        el.addEventListener('mousemove', () => {
          if (sel !== idx) { sel = idx; render(); }
        });
      });
      // announce result count + keep the combobox wiring in sync
      input.setAttribute('aria-expanded', shown.length ? 'true' : 'false');
      if (shown.length) input.setAttribute('aria-activedescendant', `palette-opt-${sel}`);
      else input.removeAttribute('aria-activedescendant');
      if (statusEl) {
        statusEl.textContent = shown.length
          ? `${shown.length} result${shown.length === 1 ? '' : 's'}`
          : 'No results';
      }
    };

    const open = () => {
      overlay.classList.add('open');
      input.value = '';
      sel = 0;
      render();
      setTimeout(() => input.focus(), 0);
      if (!items) load().then(() => overlay.classList.contains('open') && render());
    };
    const close = () => {
      overlay.classList.remove('open');
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    };

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        overlay.classList.contains('open') ? close() : open();
      } else if (e.key === 'Escape') close();
      else if (overlay.classList.contains('open')) {
        if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(sel + 1, shown.length - 1); render(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(sel - 1, 0); render(); }
        else if (e.key === 'Enter' && shown[sel]) window.location.href = shown[sel].url;
      }
    });
    input.addEventListener('input', () => { sel = 0; render(); });
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.querySelectorAll('[data-palette-open]').forEach((btn) => btn.addEventListener('click', open));
  })();
</script>
