---
/**
 * Full-viewport living background for the homepage.
 * Mounts the OKBackdrop WebGL nebula field (src/scripts/backdrop.js, verbatim
 * from the background handoff). Graceful 2D fallback + reduced-motion handled
 * inside backdrop.js.
 */
---

<div class="aurora-wrap" aria-hidden="true">
  <canvas data-backdrop></canvas>
</div>

<style>
  .aurora-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #04040d; /* nebula base — shown before the canvas paints */
  }
  .aurora-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import '../scripts/backdrop.js';

  const canvas = document.querySelector('[data-backdrop]');
  const OKBackdrop = (window as any).OKBackdrop;
  if (canvas && OKBackdrop) {
    OKBackdrop.mount(canvas, {
      palette: 'violet-dusk',
      intensity: 1.05,
      noMouse: true,
    });
  }
</script>
